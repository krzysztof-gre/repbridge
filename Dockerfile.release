FROM --platform=$BUILDPLATFORM golang:1.27.3-alpine@sha256:b8c9b82affbbb82a020bbcf998dad2ba9516944ac7e883524642a481a9505e9c AS assets
RUN mkdir -p /out/data /out/config && chmod 0700 /out/data /out/config

FROM alpine:3.22@sha256:2e0b81d60597f449baa56dc25d355367869d2dca4cd57e866f1e2b52af3eb55f
ARG TARGETPLATFORM
ARG TARGETARCH
COPY --from=assets /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=assets --chown=65532:65532 /out/data /data
COPY --from=assets --chown=65532:65532 /out/config /config
COPY ${TARGETPLATFORM}/repbridge /usr/local/bin/repbridge
COPY dist/licenses_${TARGETARCH} /usr/share/licenses/repbridge/dependencies
COPY LICENSE NOTICE /usr/share/licenses/repbridge/
COPY scripts/setup.sh /opt/repbridge/setup.sh
ENV HOME=/tmp \
    REPBRIDGE_TOKEN_FILE=/data/credentials.enc \
    REPBRIDGE_VAULT_KEY_FILE=/run/secrets/repbridge-vault-key
WORKDIR /work
USER 65532:65532
EXPOSE 8787 8080
ENTRYPOINT ["/usr/local/bin/repbridge"]
CMD ["help"]
