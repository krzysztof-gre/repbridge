# Nonsecret configuration only. Never put keys or Garmin credentials here.
# Optional ChatGPT tunnel; omit for local MCP.
REPBRIDGE_OPENAI_TUNNEL_ID=tunnel_REPLACE_WITH_YOUR_TUNNEL_ID
# Existing host-file deployments only (compose.yaml):
# REPBRIDGE_CONFIG_DIR=/absolute/path/to/private/config
# REPBRIDGE_HOST_GID=1000

# Optional reviewed release image, preferably pinned by digest:
# REPBRIDGE_IMAGE=ghcr.io/OWNER/REPOSITORY@sha256:REPLACE_WITH_RELEASE_DIGEST
